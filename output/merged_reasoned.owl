  <rdfs:subClassOf rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetes mellitus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#ClinicalOfficer">
  <rdfs:subClassOf rdf:resource="#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Officer / NP</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/HypotensionRisk">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/InteractionAlert"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypotension Risk (Amlodipine + Grapefruit)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/387353006">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/373873005"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Prescription"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Salbutamol</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/709044004">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic kidney disease</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-a.org/ehr#ChronicCondition">
  <rdfs:subClassOf rdf:resource="http://hospital-a.org/ehr#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic Condition</rdfs:label>
</owl:Class>


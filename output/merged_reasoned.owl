<owl:Class rdf:about="http://snomed.info/id/HypotensionRiskPatient">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://snomed.info/id/125676002"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
          <owl:someValuesFrom rdf:resource="http://snomed.info/id/372605008"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://snomed.info/id/consumes"/>
          <owl:someValuesFrom rdf:resource="http://snomed.info/id/110540003"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#EHR_Record"/>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/BleedingRiskPatient">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">

<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://hospital-a.org/ehr"
         xmlns="http://hospital-a.org/ehr#"
         xmlns:clin="http://hospital-b.org/clinical#"
         xmlns:id="http://snomed.info/id/">

<owl:Ontology rdf:about="http://hospital-a.org/ehr">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hospital A - Electronic Health Record (EHR) Ontology</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A semantically rich local ontology structurally enforcing EHR documentation standards.</rdfs:comment>
</owl:Ontology>

<owl:Ontology rdf:about="http://hospital-b.org/clinical">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hospital B - Clinical &amp; Trial Data Ontology</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A semantically rich clinical ontology with domain/range constraints and disjoint classes.</rdfs:comment>
</owl:Ontology>

<owl:Ontology rdf:about="http://medonto.org/snomed-mapping"/>

<owl:Ontology rdf:about="http://snomed.info/id/core">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNOMED CT Subset</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lightweight simulation of SNOMED CT using real SCTIDs for integration.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#hasGeneticDiagnosis">
  <rdfs:subPropertyOf rdf:resource="http://hospital-b.org/clinical#hasDiagnosis"/>
  <owl:equivalentProperty rdf:resource="#hasGeneticCondition"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confirmed genetic diagnosis</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#underCareOf">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <owl:inverseOf rdf:resource="http://hospital-b.org/clinical#caresFor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is under the primary care of</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#knowsPatient">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is friends with another patient</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#hasBiologicalAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <owl:equivalentProperty rdf:resource="#hasAncestor"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological ancestor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="#EHR_Record"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasBiologicalAncestor"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has biological ancestor</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCondition">
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="#Condition"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasDiagnosis"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/associatedWith"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has condition</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#hasDiagnosis">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#Diagnosis"/>
  <owl:equivalentProperty rdf:resource="#hasCondition"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/associatedWith"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has confirmed diagnosis</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#hasNutritionEntry">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#NutritionEntry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consumed nutritional item</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGeneticCondition">
  <rdfs:subPropertyOf rdf:resource="#hasCondition"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasGeneticDiagnosis"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has confirmed genetic disease</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#seenBy">
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="#AttendingPhysician"/>
  <owl:inverseOf rdf:resource="#treatsPatient"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#underCareOf"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is seen by</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#onMedication">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#Medication"/>
  <owl:equivalentProperty rdf:resource="#hasPrescription"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is currently taking medication</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#consultsWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consults with peer safely (symmetric)</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/associatedWith">
  <owl:equivalentProperty rdf:resource="#hasCondition"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasDiagnosis"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has clinical finding</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reliesOnColleague">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#MedicalPersonnel"/>
  <rdfs:range rdf:resource="#MedicalPersonnel"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relies on specialist colleague</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/prescribedTo">
  <owl:equivalentProperty rdf:resource="#hasPrescription"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#onMedication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is prescribed product</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/consumes">
  <owl:eßquivalentProperty rdf:resource="http://hospital-b.org/clinical#hasNutritionEntry"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consumes substance</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#caresFor">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <owl:inverseOf rdf:resource="http://hospital-b.org/clinical#underCareOf"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provides care for</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasParent">
  <rdfs:subPropertyOf rdf:resource="#hasAncestor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has biological parent</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#eligibleForPeerSecondOpinionFrom">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://hospital-b.org/clinical#knowsPatient"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://hospital-b.org/clinical#underCareOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eligible for peer network second opinion</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#hasBiologicalParent">
  <rdfs:subPropertyOf rdf:resource="http://hospital-b.org/clinical#hasBiologicalAncestor"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/hasBiologicalParent"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biological parent</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://hospital-b.org/clinical#eligibleForSecondOpinionFrom">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://hospital-b.org/clinical#underCareOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://hospital-b.org/clinical#consultsWith"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eligible for second opinion from</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasRisk">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has interaction risk</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrescription">
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="#Prescription"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#onMedication"/>
  <owl:equivalentProperty rdf:resource="http://snomed.info/id/prescribedTo"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">has prescription</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasGeneticDisease">
  <owl:equivalentProperty rdf:resource="#hasGeneticCondition"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasGeneticDiagnosis"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#treatsPatient">
  <rdfs:domain rdf:resource="#AttendingPhysician"/>
  <rdfs:range rdf:resource="#EHR_Record"/>
  <owl:inverseOf rdf:resource="#seenBy"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">treats patient</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasBiologicalAncestor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <owl:equivalentProperty rdf:resource="#hasAncestor"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasBiologicalAncestor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasBiologicalParent">
  <owl:equivalentPropertƒy rdf:resource="#hasParent"/>
  <owl:equivalentProperty rdf:resource="http://hospital-b.org/clinical#hasBiologicalParent"/>
  <rdfs:subPropertyOf rdf:resource="#hasAncestor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://snomed.info/id/hasRiskOfGeneticDisease">
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://snomed.info/id/hasBiologicalAncestor"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://snomed.info/id/hasGeneticDisease"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#FullName">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#Sex">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#Human"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasSpecialty">
  <rdfs:domain rdf:resource="#MedicalPersonnel"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#PatientID">
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#Subject_Ref">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#hasSpecialty">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalOfficer"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#Patient_Name">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#Human"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#BloodType">
  <rdfs:domain rdf:resource="#EHR_Record"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#DOB">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="http://hospital-b.org/clinical#BMI">
  <rdfs:domain rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#DateOfBirth">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#Gender">
  <rdfs:domain rdf:resource="#Person"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="http://hospital-b.org/clinical#ClinicalOfficer">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Officer / NP</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#ClinicalSubject">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#Human"/>
  <owl:disjointWith rdf:resource="http://hospital-b.org/clinical#ClinicalStaff"/>
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:equivalentClass rdf:resource="#EHR_Record"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/125676002"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Trial Subject / Patient</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/125676002">
  <owl:equivalentClass rdf:resource="#EHR_Record"/>
  <owl:equivalentClass rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person (Patient/Subject)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EHR_Record">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <owl:disjointWith rdf:resource="#MedicalPersonnel"/>
  <owl:equivalentClass rdf:resource="http://hospital-b.org/clinical#ClinicalSubject"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/125676002"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electronic Health Record (Patient Profile)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#Observation">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#ClinicalEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Observation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#ClinicalEntity">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Base Clinical Entity</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#ClinicalStaff">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#Human"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical Staff Member</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#Human">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#ClinicalEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human Being</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/387353006">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/373873005"/>
  <rdfs:subClassOf rdf:resource="#Prescription"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Salbutamol</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/373873005">
  <owl:equivalentClass rdf:resource="#Prescription"/>
  <owl:equivalentClass rdf:resource="http://hospital-b.org/clinical#Medication"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pharmaceutical / biologic product</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Condition">
  <rdfs:subClassOf rdf:resource="#ClinicalConcept"/>
  <owl:equivalentClass rdf:resource="http://hospital-b.org/clinical#Diagnosis"/>
  <owl:equivalentClass rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medical Condition or Disease</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/372567009">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/373873005"/>
  <rdfs:subClassOf rdf:resource="#Prescription"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metformin</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/73211009">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetes mellitus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/372605008">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/373873005"/>
  <rdfs:subClassOf rdf:resource="#Prescription"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amlodipine</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MedicalPersonnel">
  <rdfs:subClassOf rdf:resource="#Person"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medical Personnel</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#Regimen">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#ClinicalEntity"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient Regimen</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/397156001">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/373873005"/>
  <rdfs:subClassOf rdf:resource="#Prescription"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NSAID (Non-steroidal anti-inflammatory drug)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/58756001">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/32895009"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Huntington's chorea (disorder)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/32895009">
  <rdfs:subClassOf rdf:resource="http://snomed.info/id/404684003"/>
  <rdfs:subClassOf rdf:resource="#Condition"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hereditary disease</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://snomed.info/id/404684003">
  <owl:equivalentClass rdf:resource="#Condition"/>
  <owl:equivalentClass rdf:resource="http://hospital-b.org/clinical#Diagnosis"/>
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#Observation"/>
  <rdfs:subClassOf rdf:resource="#ClinicalConcept"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical finding (Disease)</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://hospital-b.org/clinical#Diagnosis">
  <rdfs:subClassOf rdf:resource="http://hospital-b.org/clinical#Observation"/>

clin:AcetylsalicylicAcid a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Acetylsalicylic Acid" ;
    owl:sameAs med:Aspirin .

clin:Amlodipine a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Amlodipine" ;
    owl:sameAs med:Amlodipine .

clin:BronchialAsthma a clin:Diagnosis,
        owl:NamedIndividual ;
    clin:DiagnosisText "Bronchial asthma" ;
    clin:ICDCode "J45" ;
    owl:sameAs med:Asthma .

clin:ChronicRenalFailure a clin:Diagnosis,
        owl:NamedIndividual ;
    clin:DiagnosisText "Chronic renal failure" ;
    clin:ICDCode "N18" ;
    owl:sameAs med:ChronicKidneyDisease .

clin:Dr__Riya_Patel a clin:ClinicalOfficer ;
    clin:Patient_Name "Dr. Riya Patel" ;
    med:treats <http://hospital-b.org/patient#ET_2024_003>,
        <http://hospital-b.org/patient#MK_2024_004> .

clin:Grapefruit a clin:NutritionEntry,
        owl:NamedIndividual ;
    clin:FoodItem "Grapefruit" ;
    owl:sameAs med:Grapefruit .

clin:GrapefruitJuice a clin:NutritionEntry,
        owl:NamedIndividual ;
    clin:FoodItem "Grapefruit Juice" ;
    owl:sameAs med:Grapefruit .

clin:Ibuprofen a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Ibuprofen" ;
    owl:sameAs med:Ibuprofen .

clin:Lisinopril a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Lisinopril" ;
    owl:sameAs med:Lisinopril .

clin:MetforminHydrochloride a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Metformin Hydrochloride" ;
    owl:sameAs med:Metformin .

clin:SalbutamolSulfate a clin:Medication,
        owl:NamedIndividual ;
    clin:GenericName "Salbutamol Sulfate" ;
    owl:sameAs med:Salbutamol .


med:Antihypertensive a owl:Class ;
    rdfs:label "Antihypertensive" ;
    rdfs:subClassOf med:Drug .

med:Aspirin a med:NSAID,
        owl:NamedIndividual ;
    med:drugName "Aspirin" ;
    owl:sameAs ehr:Aspirin,
        clin:AcetylsalicylicAcid .

med:Asthma a med:RespiratoryDisease,
        owl:NamedIndividual ;
    rdfs:label "Asthma (Global)" ;
    owl:sameAs ehr:Asthma,
        clin:BronchialAsthma .

med:ChronicKidneyDisease a med:RenalDisease,
        owl:NamedIndividual ;
    rdfs:label "Chronic Kidney Disease (Global)" ;
    owl:sameAs ehr:ChronicKidneyDisease,
        clin:ChronicRenalFailure .

med:Diabetes a med:MetabolicDisorder,
        owl:NamedIndividual ;
    rdfs:label "Diabetes (Global)" ;
    owl:sameAs ehr:DiabetesType2,
        clin:AdultOnsetDiabetes .

med:FoodSubstance a owl:Class ;
    rdfs:label "Food Substance" ;
    rdfs:comment "A food item that may interact with medications. Only Hospital B records these." ;
    owl:equivalentClass clin:NutritionEntry .

med:Grapefruit a med:CYP3A4Inhibitor,
        owl:NamedIndividual ;
    rdfs:label "Grapefruit" ;
    rdfs:comment "Inhibits CYP3A4 liver enzymes. Interacts dangerously with Warfarin, Amlodipine, and others." ;
    owl:sameAs clin:Grapefruit,
        clin:GrapefruitJuice .

med:Hypertension a med:CardiovascularDisease,
        owl:NamedIndividual ;
    rdfs:label "Hypertension (Global)" ;
    owl:sameAs ehr:Hypertension,
        clin:EssentialHypertension .

med:Ibuprofen a med:NSAID,
        owl:NamedIndividual ;
    med:drugName "Ibuprofen" ;
    owl:sameAs ehr:Ibuprofen,
        clin:Ibuprofen .

med:Lisinopril a med:Antihypertensive,
        owl:NamedIndividual ;
    med:drugName "Lisinopril" ;
    owl:sameAs ehr:Lisinopril,
        clin:Lisinopril .

med:Metformin a med:Antidiabetic,
        owl:NamedIndividual ;
    med:drugName "Metformin" ;
    owl:sameAs ehr:Metformin,
        clin:MetforminHydrochloride .

med:NSAID a owl:Class ;
    rdfs:label "NSAID" ;
    rdfs:comment "Non-Steroidal Anti-Inflammatory Drug. Superclass of Aspirin, Ibuprofen, etc." ;
    rdfs:subClassOf med:Drug .

med:Salbutamol a med:Bronchodilator,
        owl:NamedIndividual ;
    med:drugName "Salbutamol" ;
    owl:sameAs ehr:Salbutamol,
        clin:SalbutamolSulfate .

ehr:DiabetesType2 a ehr:Condition,
        owl:NamedIndividual ;
    rdfs:label "Diabetes Type 2" ;
    owl:sameAs med:Diabetes .

ehr:Hypertension a ehr:Condition,
        owl:NamedIndividual ;
    rdfs:label "Hypertension" ;
    owl:sameAs med:Hypertension .

ehr:Metformin a ehr:Prescription,
        owl:NamedIndividual ;
    ehr:DrugName "Metformin" ;
    owl:sameAs med:Metformin .

clin:AdultOnsetDiabetes a clin:Diagnosis,
        owl:NamedIndividual ;
    clin:DiagnosisText "Adult-onset diabetes" ;
    clin:ICDCode "E11" ;
    owl:sameAs med:Diabetes .

clin:EssentialHypertension a clin:Diagnosis,
        owl:NamedIndividual ;
    clin:DiagnosisText "Essential hypertension" ;
    clin:ICDCode "I10" ;
    owl:sameAs med:Hypertension .

ehr:AttendingPhysician a owl:Class ;
    rdfs:label "Attending Physician" .

med:DangerousInteraction a owl:Class ;
    rdfs:label "Dangerous Interaction" ;
    rdfs:comment "A clinically dangerous drug-drug or drug-food combination. Instances are inferred by the reasoner." .

clin:ClinicalOfficer a owl:Class ;
    rdfs:label "Clinical Officer" .

clin:NutritionEntry a owl:Class ;
    rdfs:label "Nutrition Entry" ;
    rdfs:comment "A food item recorded in Hospital B's patient nutrition log." .

med:Disease a owl:Class ;
    rdfs:label "Disease" ;
    owl:equivalentClass ehr:Condition,
        clin:Diagnosis .

ehr:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A medical condition as recorded in Hospital A's EHR." .

med:Drug a owl:Class ;
    rdfs:label "Drug" ;
    owl:equivalentClass ehr:Prescription,
        clin:Medication .

med:Patient a owl:Class ;
    rdfs:label "Patient" ;
    rdfs:comment "Global canonical class for any person receiving medical care, regardless of which hospital uses which terminology." ;
    owl:equivalentClass ehr:EHR_Record,
        clin:ClinicalSubject .

clin:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis" ;
    rdfs:comment "A clinical diagnosis, typically coded using ICD-10 codes." .

clin:Medication a owl:Class ;
    rdfs:label "Medication" ;
    rdfs:comment "A medication in Hospital B's clinical records." .

ehr:Prescription a owl:Class ;
    rdfs:label "Prescription" ;
    rdfs:comment "A drug prescribed to a patient in Hospital A." .

ehr:EHR_Record a owl:Class ;
    rdfs:label "EHR Record" ;
    rdfs:comment "A patient record in Hospital A's Electronic Health Record system." .

clin:ClinicalSubject a owl:Class ;
    rdfs:label "Clinical Subject" ;
    rdfs:comment "A patient in Hospital B's clinical system, referred to as a 'subject'." .

